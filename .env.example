# Experio Dental Clinics — Environment Configuration Template
# Copy this file to .env.local for local overrides.
# NOTE: Do NOT add sensitive private API secrets or patient credentials here.

# Clinic Verified WhatsApp Integration
# Formatted international phone number without '+' or special characters (e.g. 201029720243).
# When left unset or set to placeholder, the frontend runs in safe demo fallback mode.
VITE_WHATSAPP_NUMBER=201029720243

# Optional: Booking API endpoint URL when server-side integration is ready
# VITE_BOOKING_API_URL=https://api.experio-dental.com/v1/appointments

# Concept Demo Mode Flag (true enables simulated client-side submission with receipt modal)
VITE_DEMO_MODE=true
